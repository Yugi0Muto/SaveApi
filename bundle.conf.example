# ============================================================
# bundle.conf — configuration du bundle (copier en bundle.conf)
#   cp bundle.conf.example bundle.conf && chmod 600 bundle.conf
# Toutes les valeurs marquées A_COMPLETER sont OBLIGATOIRES.
# Listes = valeurs séparées par des espaces, entre guillemets.
# Les commentaires sont placés AU-DESSUS de chaque variable (jamais en fin de ligne).
# ============================================================

# --- Wazuh --------------------------------------------------
# Branche Wazuh installée sur le manager
WAZUH_BRANCH="4.14"
# Rempli automatiquement par l'étape 01 (ex: 4.14.1-1)
WAZUH_VERSION=""

# --- Serveur Wazuh (segment SERVEURS) ----------------------
# IP FIXE du serveur Wazuh
MANAGER_IP="A_COMPLETER"
MANAGER_HOSTNAME="wazuh-siem"

# --- Plan réseau (CIDR) -------------------------------------
# Exemple: 10.10.10.0/24
SERVERS_CIDR="A_COMPLETER"
# Exemple: 10.10.20.0/24 (plusieurs: séparer par espace)
EMPLOYEES_CIDR="A_COMPLETER"
# Exemple: 10.10.30.0/24
DMZ_CIDR="A_COMPLETER"
# Postes autorisés à administrer (SSH, Dashboard 443, et Grafana 3000 si Grafana est local)
# Exemple: 10.10.10.50/32 10.10.10.51/32
ADMIN_CIDRS="A_COMPLETER"

# IP jamais bloquées par l'Active Response (passerelles, DNS, admin, scanners...)
# Le manager et ADMIN_CIDRS sont ajoutés automatiquement.
WHITELIST_EXTRA=""

# --- SSH du serveur Wazuh -----------------------------------
# PermitRootLogin no, MaxAuthTries 4 (appliqué seulement si un compte sudo existe)
SSH_HARDEN="true"
# true = clés SSH uniquement (vérifie authorized_keys avant)
SSH_DISABLE_PASSWORD="false"

# --- Rétention des alertes (indexer) ------------------------
RETENTION_DAYS="90"

# --- Détection malware --------------------------------------
YARA_SCAN_PATHS_REGEX="^/(var/www|tmp|var/tmp|dev/shm|home)/"
MALWARE_HASH_URL="https://bazaar.abuse.ch/export/txt/sha256/recent/"
# Clé abuse.ch si le service l'exige
ABUSECH_AUTH_KEY=""

# --- Alertes email (relais SMTP de l'entreprise) ------------
EMAIL_ENABLE="false"
SMTP_RELAY="smtp.entreprise.local:25"
# Vide = relais sans authentification
SMTP_USER=""
EMAIL_FROM="wazuh@entreprise.local"
EMAIL_TO="soc@entreprise.local"
EMAIL_ALERT_LEVEL="10"

# --- Alertes SMS (Africa's Talking) -------------------------
SMS_ENABLE="false"
# "sandbox" = aucun SMS réellement livré
SMS_USERNAME="sandbox"
# Plusieurs numéros: séparer par espace
SMS_TO="+241XXXXXXXX"
SMS_ALERT_LEVEL="12"
SMS_MAX_PER_HOUR="20"
SMS_DEDUP_SECONDS="300"

# --- Grafana -------------------------------------------------
# true = mettre en place Grafana + dashboard ; false = l'étape 06 est ignorée
GRAFANA_ENABLE="true"
# Emplacement du serveur Grafana :
#   local  = sur CETTE machine : l'étape 06 installe Grafana (port 3000 ouvert aux ADMIN_CIDRS)
#   remote = sur une AUTRE machine : l'étape 06 prépare l'indexer (utilisateur lecture seule),
#            ouvre le port 9200 uniquement pour GRAFANA_REMOTE_IPS et génère un kit
#            à copier puis installer sur la machine Grafana (voir README)
GRAFANA_MODE="local"
# Mode remote uniquement (obligatoire dans ce cas) : IP ou CIDR de la machine Grafana
# Exemple: 10.10.10.60/32 (plusieurs: séparer par espace)
GRAFANA_REMOTE_IPS=""
# Version OpenSearch réelle de l'indexer (voir docs)
OPENSEARCH_DS_VERSION="2.19.0"

# --- Sauvegardes --------------------------------------------------
BACKUP_DIR="/var/backups/wazuh"
BACKUP_KEEP_DAYS="14"
